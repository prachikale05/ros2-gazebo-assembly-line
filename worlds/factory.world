<?xml version="1.0" ?>
<sdf version="1.6">

  <world name="factory_world">

    <!-- ========================= -->
    <!-- Physics -->
    <!-- ========================= -->
    
    <!-- ROS 2 Gazebo state services -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"/>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ========================= -->
    <!-- Gravity -->
    <!-- ========================= -->

    <gravity>0 0 -9.81</gravity>

    <!-- ========================= -->
    <!-- Ground Plane -->
    <!-- ========================= -->

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ========================= -->
    <!-- Sun -->
    <!-- ========================= -->

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ========================= -->
    <!-- Factory Floor -->
    <!-- ========================= -->

    <model name="factory_floor">

      <static>true</static>

      <link name="floor_link">

        <collision name="floor_collision">

          <geometry>
            <box>
              <size>20 12 0.1</size>
            </box>
          </geometry>

        </collision>

        <visual name="floor_visual">

          <geometry>
            <box>
              <size>20 12 0.1</size>
            </box>
          </geometry>

        </visual>

      </link>

      <pose>0 0 -0.05 0 0 0</pose>

    </model>
    
  </world>

</sdf>

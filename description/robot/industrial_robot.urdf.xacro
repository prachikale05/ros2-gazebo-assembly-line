<?xml version="1.0"?>

<robot name="industrial_robot"
       xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ================================================= -->
  <!-- WORLD ANCHOR -->
  <!-- ================================================= -->

  <link name="world"/>

  <!-- ================================================= -->
  <!-- MATERIALS -->
  <!-- ================================================= -->

  <material name="robot_blue">
    <color rgba="0.95 0.35 0.05 1"/>
  </material>

  <material name="robot_dark">
    <color rgba="0.06 0.06 0.06 1"/>
  </material>

  <material name="metal">
    <color rgba="0.65 0.65 0.65 1"/>
  </material>


  <!-- ================================================= -->
  <!-- BASE -->
  <!-- ================================================= -->

  <link name="robot_base">

    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.5" ixy="0" ixz="0"
               iyy="0.5" iyz="0" izz="0.5"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder radius="0.30" length="0.20"/>
      </geometry>
      <material name="robot_blue"/>
    </visual>

  </link>
  
  <!-- ================================================= -->
  <!-- FIX ROBOT BASE TO WORLD -->
  <!-- ================================================= -->

  <joint name="world_to_robot_base" type="fixed">

    <parent link="world"/>
    <child link="robot_base"/>

    <origin xyz="-0.8 -0.9 0.1" rpy="0 0 0"/>

  </joint>  


  <!-- ================================================= -->
  <!-- JOINT 1 / LOWER COLUMN -->
  <!-- ================================================= -->

  <link name="link1">

    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
               iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.35"/>
      <geometry>
        <box size="0.25 0.25 0.70"/>
      </geometry>
      <material name="robot_blue"/>
    </visual>

    

  </link>

  <joint name="joint1" type="revolute">

    <parent link="robot_base"/>
    <child link="link1"/>

    <origin xyz="0 0 0.10" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit lower="-3.14" upper="3.14"
           effort="100" velocity="1.5"/>

  </joint>


  <!-- ================================================= -->
  <!-- LINK 2 -->
  <!-- ================================================= -->

  <link name="link2">

    <inertial>
      <mass value="4.0"/>
      <inertia ixx="0.2" ixy="0" ixz="0"
               iyy="0.2" iyz="0" izz="0.05"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.40"/>
      <geometry>
        <box size="0.22 0.22 0.80"/>
      </geometry>
      <material name="robot_blue"/>
    </visual>

    

  </link>

  <joint name="joint2" type="revolute">

    <parent link="link1"/>
    <child link="link2"/>

    <origin xyz="0 0 0.70" rpy="0 1.5708 0"/>

    <axis xyz="0 1 0"/>

    <limit lower="-2.5" upper="2.5"
           effort="100" velocity="1.5"/>

  </joint>


  <!-- ================================================= -->
  <!-- LINK 3 -->
  <!-- ================================================= -->

  <link name="link3">

    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.15" ixy="0" ixz="0"
               iyy="0.15" iyz="0" izz="0.04"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.35"/>
      <geometry>
        <box size="0.20 0.20 0.70"/>
      </geometry>
      <material name="robot_blue"/>
    </visual>

    

  </link>

  <joint name="joint3" type="revolute">

    <parent link="link2"/>
    <child link="link3"/>

    <origin xyz="0 0 0.80" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit lower="-2.5" upper="2.5"
           effort="100" velocity="1.5"/>

  </joint>


  <!-- ================================================= -->
  <!-- LINK 4 -->
  <!-- ================================================= -->

  <link name="link4">

    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0"
               iyy="0.08" iyz="0" izz="0.03"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <box size="0.16 0.16 0.50"/>
      </geometry>
      <material name="robot_dark"/>
    </visual>

    

  </link>

  <joint name="joint4" type="revolute">

    <parent link="link3"/>
    <child link="link4"/>

    <origin xyz="0 0 0.70" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit lower="-3.14" upper="3.14"
           effort="50" velocity="2.0"/>

  </joint>


  <!-- ================================================= -->
  <!-- LINK 5 -->
  <!-- ================================================= -->

  <link name="link5">

    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.05" ixy="0" ixz="0"
               iyy="0.05" iyz="0" izz="0.02"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.20"/>
      <geometry>
        <box size="0.14 0.14 0.40"/>
      </geometry>
      <material name="robot_blue"/>
    </visual>

    

  </link>

  <joint name="joint5" type="revolute">

    <parent link="link4"/>
    <child link="link5"/>

    <origin xyz="0 0 0.50" rpy="0 1.5708 0"/>

    <axis xyz="0 1 0"/>

    <limit lower="-2.5" upper="2.5"
           effort="50" velocity="2.0"/>

  </joint>


  <!-- ================================================= -->
  <!-- LINK 6 / WRIST -->
  <!-- ================================================= -->

  <link name="link6">

    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0"
               iyy="0.03" iyz="0" izz="0.03"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.20"/>
      </geometry>
      <material name="robot_dark"/>
    </visual>

    

  </link>

  <joint name="joint6" type="revolute">

    <parent link="link5"/>
    <child link="link6"/>

    <origin xyz="0 0 0.40" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit lower="-3.14" upper="3.14"
           effort="30" velocity="2.0"/>

  </joint>


  <!-- ================================================= -->
  <!-- GRIPPER / END EFFECTOR -->
  <!-- ================================================= -->

  <link name="gripper_palm">

    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0"
               iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry>
        <box size="0.20 0.14 0.12"/>
      </geometry>
      <material name="robot_dark"/>
    </visual>

    

  </link>

  <joint name="gripper_palm_joint" type="fixed">

    <parent link="link6"/>
    <child link="gripper_palm"/>

    <origin xyz="0 0 0.10" rpy="0 0 0"/>

  </joint>


  <!-- LEFT GRIPPER FINGER -->

  <link name="gripper_left_finger">

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.005" ixy="0" ixz="0"
               iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>

    <visual>
      <origin xyz="0 0 -0.15"/>
      <geometry>
        <box size="0.06 0.08 0.30"/>
      </geometry>
      <material name="robot_dark"/>
    </visual>
    
    <!-- PHYSICAL COLLISION -->
    <collision>
      <origin xyz="0 0 -0.15"/>
      <geometry>
        <box size="0.06 0.08 0.30"/>
      </geometry>

      <surface>
        <friction>
          <ode>
           <mu>5.0</mu>
            <mu2>5.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

    

  
</link>

  <joint name="gripper_left_finger_joint" type="prismatic">

    <parent link="gripper_palm"/>
    <child link="gripper_left_finger"/>

    <origin xyz="0.07 0 -0.02" rpy="0 0 0"/>

    <axis xyz="1 0 0"/>

    <limit lower="0.0" upper="0.12"
           effort="20" velocity="0.2"/>

  </joint>


  <!-- RIGHT GRIPPER FINGER -->

  <link name="gripper_right_finger">

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.005" ixy="0" ixz="0"
               iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>

    <visual>
      <origin xyz="0 0 -0.15"/>
      <geometry>
        <box size="0.06 0.08 0.30"/>
      </geometry>
      <material name="robot_dark"/>
    </visual>
    
    <!-- PHYSICAL COLLISION -->
    <collision>
      <origin xyz="0 0 -0.15"/>
      <geometry>
        <box size="0.06 0.08 0.30"/>
      </geometry>

      <surface>
        <friction>
          <ode>
            <mu>5.0</mu>
            <mu2>5.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

  
</link>

  <joint name="gripper_right_finger_joint" type="prismatic">

    <parent link="gripper_palm"/>
    <child link="gripper_right_finger"/>

    <origin xyz="-0.07 0 -0.02" rpy="0 0 0"/>

    <axis xyz="1 0 0"/>

    <limit lower="-0.12" upper="0.00"
           effort="20" velocity="0.2"/>

  </joint>


  <!-- ================================================= -->
  <!-- TEMPORARY STATIC ROBOT -->
  <!-- ================================================= -->

  <gazebo reference="robot_base">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="link1">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="link2">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="link3">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="link4">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="link5">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="link6">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

<!-- ================================================= -->
  <!-- ROS 2 CONTROL -->
  <!-- ================================================= -->



  <gazebo reference="robot_base">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link1">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link2">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link3">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link4">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link5">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="link6">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="gripper_palm">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="gripper_left_finger">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
  </gazebo>

  <gazebo reference="gripper_right_finger">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
  </gazebo>

  <ros2_control name="GazeboSystem" type="system">

    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>


  <!-- Gazebo ROS 2 Control -->

  <gazebo>
    <plugin
      name="gazebo_ros2_control_workstation1"
      filename="libgazebo_ros2_control.so">

      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>

      <parameters>
        /home/prachi/assembly_line_ws/install/assembly_line/share/assembly_line/config/robot_controllers.yaml
      </parameters>

    </plugin>
  </gazebo>

</robot>

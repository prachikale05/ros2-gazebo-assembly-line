<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="conveyor">

  <!-- ================= MATERIALS ================= -->

  <material name="frame_material">
    <color rgba="0.60 0.60 0.60 1"/>
  </material>

  <material name="belt_material">
    <color rgba="0.015 0.015 0.015 1"/>
  </material>

  <material name="roller_material">
    <color rgba="0.75 0.75 0.75 1"/>
  </material>


  <!-- ================= WORLD ================= -->
  <link name="world"/>
  
  <!-- ================= BASE ================= -->

  <link name="conveyor_base">
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0.4"/>
      <inertia
        ixx="0.60"
        ixy="0"
        ixz="0"
        iyy="13.35"
        iyz="0"
        izz="13.35"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.4"/>
      <geometry>
        <box size="4.0 0.8 0.8"/>
      </geometry>
      <material name="frame_material"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.4"/>
      <geometry>
        <box size="4.0 0.8 0.8"/>
      </geometry>
    </collision>
  </link>


  <!-- ================= FIX CONVEYOR TO WORLD ================= -->

  <joint name="conveyor_world_joint" type="fixed">
    <parent link="world"/>
    <child link="conveyor_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  
  <!-- ================= BELT ================= -->

  <link name="belt">

    <inertial>
      <mass value="8.0"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.34"
        ixy="0"
        ixz="0"
        iyy="10.67"
        iyz="0"
        izz="10.67"/>
    </inertial>

    <visual>
      <geometry>
        <box size="4.0 0.7 0.1"/>
      </geometry>
      <material name="belt_material"/>
    </visual>

    <collision>
      <geometry>
        <box size="4.0 0.7 0.1"/>
      </geometry>
      
      <surface>
        <friction>
          <ode>
            <mu>5.0</mu>
            <mu2>5.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

  </link>

  <joint name="belt_joint" type="fixed">
    <parent link="conveyor_base"/>
    <child link="belt"/>
    <origin xyz="0 0 0.82" rpy="0 0 0"/>
  </joint>


  <!-- ================= LEFT FRAME ================= -->

  <link name="left_frame">

    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.347"
        ixy="0"
        ixz="0"
        iyy="6.67"
        iyz="0"
        izz="6.67"/>
    </inertial>

    <visual>
      <geometry>
        <box size="4.0 0.1 0.8"/>
      </geometry>
      <material name="frame_material"/>
    </visual>

    <collision>
      <geometry>
        <box size="4.0 0.1 0.8"/>
      </geometry>
    </collision>

  </link>

  <joint name="left_frame_joint" type="fixed">
    <parent link="conveyor_base"/>
    <child link="left_frame"/>
    <origin xyz="0 0.35 0.4" rpy="0 0 0"/>
  </joint>


  <!-- ================= RIGHT FRAME ================= -->

  <link name="right_frame">

    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.347"
        ixy="0"
        ixz="0"
        iyy="6.67"
        iyz="0"
        izz="6.67"/>
    </inertial>

    <visual>
      <geometry>
        <box size="4.0 0.1 0.8"/>
      </geometry>
      <material name="frame_material"/>
    </visual>

    <collision>
      <geometry>
        <box size="4.0 0.1 0.8"/>
      </geometry>
    </collision>

  </link>

  <joint name="right_frame_joint" type="fixed">
    <parent link="conveyor_base"/>
    <child link="right_frame"/>
    <origin xyz="0 -0.35 0.4" rpy="0 0 0"/>
  </joint>


  <!-- ================= FRONT ROLLER ================= -->

  <link name="front_roller">

    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.095"
        ixy="0"
        ixz="0"
        iyy="0.014"
        iyz="0"
        izz="0.095"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder radius="0.12" length="0.72"/>
      </geometry>
      <material name="roller_material"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.12" length="0.72"/>
      </geometry>
    </collision>

  </link>

  <joint name="front_roller_joint" type="continuous">
    <parent link="conveyor_base"/>
    <child link="front_roller"/>
    <origin xyz="-1.85 0 0.88" rpy="1.5708 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ================= REAR ROLLER ================= -->

  <link name="rear_roller">

    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.095"
        ixy="0"
        ixz="0"
        iyy="0.014"
        iyz="0"
        izz="0.095"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder radius="0.12" length="0.72"/>
      </geometry>
      <material name="roller_material"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.12" length="0.72"/>
      </geometry>
    </collision>

  </link>

  <joint name="rear_roller_joint" type="continuous">
    <parent link="conveyor_base"/>
    <child link="rear_roller"/>
    <origin xyz="1.85 0 0.88" rpy="1.5708 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ================= ROS 2 CONTROL ================= -->

  <ros2_control name="ConveyorSystem" type="system">

    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="front_roller_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_roller_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>


  <!-- ================= GAZEBO ROS 2 CONTROL ================= -->

  <gazebo reference="conveyor_base">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="belt">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="left_frame">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="right_frame">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="front_roller">
    <material>Gazebo/LightGrey</material>
  </gazebo>

  <gazebo reference="rear_roller">
    <material>Gazebo/LightGrey</material>
  </gazebo>

  <gazebo>
    <plugin
      name="gazebo_ros2_control_conveyor"
      filename="libgazebo_ros2_control.so">
      
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>

      <parameters>
        /home/prachi/assembly_line_ws/install/assembly_line/share/assembly_line/config/conveyor_controllers.yaml
      </parameters>
      
      <controller_manager_name>controller_manager</controller_manager_name>
      
    </plugin>
  </gazebo>

</robot>

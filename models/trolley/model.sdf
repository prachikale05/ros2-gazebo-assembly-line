<?xml version="1.0"?>
<sdf version="1.6">

  <model name="trolley">

    <static>true</static>

    <!-- Main pallet -->
    <link name="trolley_base">

      <collision name="base_collision">
        <geometry>
          <box>
            <size>1.0 0.8 0.12</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>1.0 0.8 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>

    </link>


    <!-- Left side support -->
    <link name="left_support">

      <pose>0 0.34 0.25 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>1.0 0.08 0.4</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>1.0 0.08 0.4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

    </link>


    <!-- Right side support -->
    <link name="right_support">

      <pose>0 -0.34 0.25 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>1.0 0.08 0.4</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>1.0 0.08 0.4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

    </link>


    <!-- Front support -->
    <link name="front_support">

      <pose>0.46 0 0.25 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.08 0.8 0.4</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.08 0.8 0.4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

    </link>


    <!-- Back support -->
    <link name="back_support">

      <pose>-0.46 0 0.25 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.08 0.8 0.4</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.08 0.8 0.4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

    </link>

  </model>

</sdf>
